# Names and shapes only. Values never live in a file that is committed.
#
# Every variable a provider binding names in manifest.yaml belongs here, so
# that whoever fills .env sees it. Nothing compares this file with the
# manifest: `kernel-check-instance` does not read the manifest, and a
# variable left out here is caught only at boot, which refuses a declared
# variable whose value is not set.

# The engine's database. The pooled URL for the application, the direct one
# for migrations — a transaction pooler cannot run them.
DATABASE_URL=
DIRECT_URL=

# The sandbox adapters need no credential. Add here every variable a real
# binding in manifest.yaml declares, when you add the binding.

# The HTTP API, if the instance serves it (decision 0040): its token, at
# least 32 characters, and its port. KERNEL_API_HOST is optional; without it
# the API listens on the loopback address only.
KERNEL_API_TOKEN=
KERNEL_API_PORT=
