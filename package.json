{
  "name": "@werunfoundry/kernel",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "pnpm -r build",
    "test": "pnpm test:checks && pnpm test:engine",
    "test:checks": "node --test \"scripts/**/*.test.mjs\"",
    "test:engine": "node --import tsx --test --test-timeout=60000 \"core/**/*.test.ts\" \"domains/**/*.test.ts\" \"api/**/*.test.ts\" \"adapters/**/*.test.ts\" \"template/**/*.test.ts\"",
    "new-instance": "node scripts/new-instance.mjs",
    "try-instance": "node scripts/try-instance.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm -r --workspace-concurrency=1 db:generate",
    "db:migrate": "pnpm -r --workspace-concurrency=1 db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "pg": "^8.13.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
}
