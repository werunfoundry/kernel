{
  "name": "@werunfoundry/relations",
  "version": "0.1.0",
  "description": "People, companies, audiences, interactions and signals.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./domain.yaml": "./domain.yaml",
    "./db/schema": "./db/schema.ts",
    "./contracts": "./contracts/index.ts",
    "./contracts/crm": "./contracts/crm.ts",
    "./contracts/enrichment": "./contracts/enrichment.ts",
    "./contracts/people-source": "./contracts/people-source.ts",
    "./runtime/record": "./runtime/record.ts",
    "./runtime/relationship": "./runtime/relationship.ts",
    "./db/migrations/*": "./db/migrations/*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./domain.yaml": "./domain.yaml",
      "./db/schema": {
        "types": "./dist/db/schema.d.ts",
        "default": "./dist/db/schema.js"
      },
      "./contracts": {
        "types": "./dist/contracts/index.d.ts",
        "default": "./dist/contracts/index.js"
      },
      "./contracts/crm": {
        "types": "./dist/contracts/crm.d.ts",
        "default": "./dist/contracts/crm.js"
      },
      "./contracts/enrichment": {
        "types": "./dist/contracts/enrichment.d.ts",
        "default": "./dist/contracts/enrichment.js"
      },
      "./contracts/people-source": {
        "types": "./dist/contracts/people-source.d.ts",
        "default": "./dist/contracts/people-source.js"
      },
      "./runtime/record": {
        "types": "./dist/runtime/record.d.ts",
        "default": "./dist/runtime/record.js"
      },
      "./runtime/relationship": {
        "types": "./dist/runtime/relationship.d.ts",
        "default": "./dist/runtime/relationship.js"
      },
      "./db/migrations/*": "./db/migrations/*"
    }
  },
  "dependencies": {
    "@werunfoundry/core": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "files": [
    "dist",
    "domain.yaml",
    "db/migrations",
    "!dist/*.tsbuildinfo"
  ]
}
