{
  "name": "@werunfoundry/core",
  "version": "0.1.0",
  "description": "Governance core. Contains no business word.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./db/schema": "./db/schema.ts",
    "./manifest/types": "./manifest/types.ts",
    "./manifest": "./manifest/index.ts",
    "./manifest/validate": "./manifest/validate.ts",
    "./manifest/load": "./manifest/load.ts",
    "./contracts": "./contracts/index.ts",
    "./contracts/types": "./contracts/types.ts",
    "./runtime/boot": "./runtime/boot.ts",
    "./runtime/resolve": "./runtime/resolve.ts",
    "./runtime/run": "./runtime/run.ts",
    "./runtime/experiment": "./runtime/experiment.ts",
    "./runtime/verify": "./runtime/verify.ts",
    "./identity": "./identity/index.ts",
    "./db/migrations/*": "./db/migrations/*",
    "./runtime/connect": "./runtime/connect.ts",
    "./runtime/migrate": "./runtime/migrate.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./db/schema": {
        "types": "./dist/db/schema.d.ts",
        "default": "./dist/db/schema.js"
      },
      "./manifest/types": {
        "types": "./dist/manifest/types.d.ts",
        "default": "./dist/manifest/types.js"
      },
      "./manifest": {
        "types": "./dist/manifest/index.d.ts",
        "default": "./dist/manifest/index.js"
      },
      "./manifest/validate": {
        "types": "./dist/manifest/validate.d.ts",
        "default": "./dist/manifest/validate.js"
      },
      "./manifest/load": {
        "types": "./dist/manifest/load.d.ts",
        "default": "./dist/manifest/load.js"
      },
      "./contracts": {
        "types": "./dist/contracts/index.d.ts",
        "default": "./dist/contracts/index.js"
      },
      "./contracts/types": {
        "types": "./dist/contracts/types.d.ts",
        "default": "./dist/contracts/types.js"
      },
      "./runtime/boot": {
        "types": "./dist/runtime/boot.d.ts",
        "default": "./dist/runtime/boot.js"
      },
      "./runtime/resolve": {
        "types": "./dist/runtime/resolve.d.ts",
        "default": "./dist/runtime/resolve.js"
      },
      "./runtime/run": {
        "types": "./dist/runtime/run.d.ts",
        "default": "./dist/runtime/run.js"
      },
      "./runtime/experiment": {
        "types": "./dist/runtime/experiment.d.ts",
        "default": "./dist/runtime/experiment.js"
      },
      "./runtime/verify": {
        "types": "./dist/runtime/verify.d.ts",
        "default": "./dist/runtime/verify.js"
      },
      "./identity": {
        "types": "./dist/identity/index.d.ts",
        "default": "./dist/identity/index.js"
      },
      "./db/migrations/*": "./db/migrations/*",
      "./runtime/connect": {
        "types": "./dist/runtime/connect.d.ts",
        "default": "./dist/runtime/connect.js"
      },
      "./runtime/migrate": {
        "types": "./dist/runtime/migrate.d.ts",
        "default": "./dist/runtime/migrate.js"
      }
    },
    "bin": {
      "kernel-check-instance": "./scripts/check-instance.mjs",
      "kernel-verify": "./dist/bin/verify.js",
      "kernel-migrate": "./dist/bin/migrate.js"
    }
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "bin": {
    "kernel-check-instance": "./scripts/check-instance.mjs",
    "kernel-verify": "./bin/verify.ts",
    "kernel-migrate": "./bin/migrate.ts"
  },
  "files": [
    "dist",
    "db/migrations",
    "scripts",
    "!dist/*.tsbuildinfo"
  ]
}
