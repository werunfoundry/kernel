{
  "name": "@werunfoundry/gtm",
  "version": "0.1.0",
  "description": "Acquisition.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./domain.yaml": "./domain.yaml",
    "./db/schema": "./db/schema.ts",
    "./manifest/types": "./manifest/types.ts",
    "./manifest": "./manifest/index.ts",
    "./contracts": "./contracts/index.ts",
    "./contracts/sequencer": "./contracts/sequencer.ts",
    "./contracts/target-list": "./contracts/target-list.ts",
    "./contracts/inbound": "./contracts/inbound.ts",
    "./runtime/enrol": "./runtime/enrol.ts",
    "./runtime/draft": "./runtime/draft.ts",
    "./runtime/stage": "./runtime/stage.ts",
    "./db/migrations/*": "./db/migrations/*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./domain.yaml": "./domain.yaml",
      "./db/schema": {
        "types": "./dist/db/schema.d.ts",
        "default": "./dist/db/schema.js"
      },
      "./manifest/types": {
        "types": "./dist/manifest/types.d.ts",
        "default": "./dist/manifest/types.js"
      },
      "./manifest": {
        "types": "./dist/manifest/index.d.ts",
        "default": "./dist/manifest/index.js"
      },
      "./contracts": {
        "types": "./dist/contracts/index.d.ts",
        "default": "./dist/contracts/index.js"
      },
      "./contracts/sequencer": {
        "types": "./dist/contracts/sequencer.d.ts",
        "default": "./dist/contracts/sequencer.js"
      },
      "./contracts/target-list": {
        "types": "./dist/contracts/target-list.d.ts",
        "default": "./dist/contracts/target-list.js"
      },
      "./contracts/inbound": {
        "types": "./dist/contracts/inbound.d.ts",
        "default": "./dist/contracts/inbound.js"
      },
      "./runtime/enrol": {
        "types": "./dist/runtime/enrol.d.ts",
        "default": "./dist/runtime/enrol.js"
      },
      "./runtime/draft": {
        "types": "./dist/runtime/draft.d.ts",
        "default": "./dist/runtime/draft.js"
      },
      "./runtime/stage": {
        "types": "./dist/runtime/stage.d.ts",
        "default": "./dist/runtime/stage.js"
      },
      "./db/migrations/*": "./db/migrations/*"
    },
    "bin": {
      "kernel-enrol": "./dist/bin/enrol.js",
      "kernel-source": "./dist/bin/source.js",
      "kernel-acknowledge": "./dist/bin/acknowledge.js"
    }
  },
  "dependencies": {
    "@werunfoundry/core": "workspace:*",
    "@werunfoundry/relations": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "files": [
    "dist",
    "domain.yaml",
    "db/migrations",
    "!dist/*.tsbuildinfo"
  ],
  "bin": {
    "kernel-enrol": "./bin/enrol.ts",
    "kernel-source": "./bin/source.ts",
    "kernel-acknowledge": "./bin/acknowledge.ts"
  }
}
