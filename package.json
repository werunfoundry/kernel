{
  "name": "@werunfoundry/kernel",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "new-instance": "node scripts/new-instance.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm -r --workspace-concurrency=1 db:generate",
    "db:migrate": "pnpm -r --workspace-concurrency=1 db:migrate"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0"
  }
}
