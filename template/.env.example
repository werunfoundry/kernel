# Names and shapes only. Values never live in a file that is committed.
#
# Every variable a provider binding names in manifest.yaml must appear here,
# so that `kernel-check-instance` can tell a missing credential from a
# forgotten one.

# The engine's database. The pooled URL for the application, the direct one
# for migrations — a transaction pooler cannot run them.
DATABASE_URL=
DIRECT_URL=

# The sandbox adapters need no credential. Add here every variable a real
# binding in manifest.yaml declares, when you add the binding.
